# ===================================
# Ailuro MOOSE Application .gitignore
# ===================================

# MOOSE executables
*-opt
*-dbg
*-devel

# Build artifacts
*.o
*.d
*.a
*.la
*.lo
*.so
*.dylib
.libs/

# MOOSE output files
*.e
*.e.*
*.e-s*
*.csv
*.csv.*      

# Python cache
*.pyc
__pycache__/

# PlotPostprocessor auto-generated scripts and outputs
ailuro_plot.py
plot_*.py
*.pdf
*.png

# Temporary files
*.log
*.jou
traceout*.txt
temp_print_trace.*

# IDE/Editor configuration
.vscode/
.DS_Store

# Build directories
build/
lib/

# Restart and checkpoint files
*.rd
*.rd-*
*.cpa.gz
*.cpr
*.cpa.gz-*
*.cpr-*

# JIT cache
.jitcache/
.jitdir/
tmp_jit_*

# Auto-generated YAML configuration
ailuro.yaml
